{
  "name": "@hatoup/scorekeeper-mcp",
  "version": "1.0.0",
  "description": "A single-user stdio MCP bridge to Scorekeeper.co's live scoreboard service.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": {
    "name": "Stormlight Ventures LLC",
    "url": "https://www.scorekeeper.co"
  },
  "homepage": "https://www.scorekeeper.co/agents",
  "repository": {
    "type": "git",
    "url": "https://github.com/HatoUP/scorekeeper-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/HatoUP/scorekeeper-mcp/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "scorekeeper-mcp": "dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check src tests scripts package.json tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "npm run lint && npm run typecheck && npm test",
    "start": "node dist/src/cli.js",
    "prepack": "npm run build",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "node scripts/install-hooks.mjs --prepare",
    "package:check": "node scripts/package-check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "mcpName": "co.scorekeeper/scorekeeper"
}
